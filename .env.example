# Copy to .env and fill in. NEVER commit .env.
# All app settings use the APP_ prefix (see src/create_char_passport/config.py).

APP_ENVIRONMENT=development
APP_DEBUG=false

# --- Sentry (optional; empty DSN disables Sentry) ---
APP_SENTRY_DSN=
APP_SENTRY_ENVIRONMENT=development
APP_SENTRY_RELEASE=
APP_SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Gemini API (required in production) ---
# On HF Spaces: set via Space Secrets (same env var name, no .env file needed)
APP_GEMINI_API_KEY=

# Generation model ids (swappable; see plan/contracts.md K2).
# Defaults: Nano Banana 2 for images, 2.5-flash for LLM. Swap to
# gemini-3-pro-image-preview if facial identity drifts on NB2.
APP_IMAGE_MODEL=gemini-3.1-flash-image-preview
APP_LLM_MODEL=gemini-2.5-flash

# --- Storage (Hugging Face dataset repo used as asset bucket) ---
# Format: "owner/dataset-repo-name"
APP_HF_DATASET_BUCKET=
# Local mount path of the HF Storage Bucket (writable dev dir locally).
# On Spaces, point this at the path where the bucket is mounted.
APP_BUCKET_PATH=./data
